# Copy to .env and edit. Never commit .env.
FLOWLEVELS_DATA_DIR=data
FLOWLEVELS_CONFIG_PATH=configs/default.yaml
FLOWLEVELS_LOG_LEVEL=INFO

# Exchange endpoints (defaults shown; UNVERIFIED until `make verify-api` passes on the VPS)
FLOWLEVELS_BINANCE_REST_URL=https://fapi.binance.com
FLOWLEVELS_BINANCE_WS_URL=wss://fstream.binance.com
FLOWLEVELS_BINANCE_VISION_URL=https://data.binance.vision

# Telegram (required from Phase 5 when alerts are enabled)
FLOWLEVELS_TELEGRAM_BOT_TOKEN=
FLOWLEVELS_TELEGRAM_CHAT_ID=

# API / UI: bind to localhost; access via Tailscale or SSH tunnel
FLOWLEVELS_API_HOST=127.0.0.1
FLOWLEVELS_API_PORT=8080
